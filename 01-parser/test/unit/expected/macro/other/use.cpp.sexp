(translation_unit
  (comment)
  (declaration
    type: (primitive_type)
    declarator: (init_declarator
      declarator: (identifier)
      value: (number_literal)))
  (function_definition
    type: (class_specifier
      name: (type_identifier))
    declarator: (identifier)
    body: (compound_statement
      (labeled_statement
        label: (statement_identifier)
        (declaration
          type: (primitive_type)
          declarator: (identifier)))))
  (expression_statement))